{
  "name": "dsh-ask-first",
  "version": "0.1.0",
  "type": "module",
  "description": "不明白就先问：需求不清楚时拦截工具调用，强制先向用户提问",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": ["dsh", "dsh-plugin", "clarify", "ask-first"],
  "license": "MIT"
}
