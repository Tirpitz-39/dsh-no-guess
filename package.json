{
  "name": "dsh-no-guess",
  "version": "0.4.0",
  "type": "module",
  "description": "DSH 插件：需求不清楚时先问再干 — block tool calls on unclear requests, ask before guessing",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "ask-first",
    "clarify",
    "clarification",
    "guard"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/edge-cases.mjs && node test/attack.mjs && node test/config.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:edge": "node test/edge-cases.mjs",
    "test:attack": "node test/attack.mjs",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tirpitz-39/dsh-no-guess.git"
  },
  "homepage": "https://github.com/Tirpitz-39/dsh-no-guess#readme",
  "bugs": {
    "url": "https://github.com/Tirpitz-39/dsh-no-guess/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
